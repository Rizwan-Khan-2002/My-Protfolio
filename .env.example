# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` (root) for local dev, and add the same
# variables in your Vercel Project Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# MongoDB Atlas connection string
MONGODB_URI=your_mongodb_atlas_connection_string

# JWT secret used to sign auth tokens (use a long random string)
JWT_SECRET=your_long_random_secret

# The email address that should always be the site admin.
# On login this account is auto-promoted to role "admin".
ADMIN_EMAIL=your_admin_email@example.com

# Cloudinary (https://cloudinary.com → Dashboard → Account Details)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Contact form email (Gmail App Password)
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password
